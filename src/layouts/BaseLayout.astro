---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon-fumi.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- 見出しの PP Migra を先に読み込む(読み込み前の代わりのフォントは幅が広く、一瞬大きく見えるため) -->
    <link rel="preload" href="/fonts/PPMigra-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;900&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <!-- 登場アニメーション対象を初回描画から隠す。JS が動かなかった時は 3 秒で戻す -->
    <script is:inline>
      (function () {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var html = document.documentElement;
        html.classList.add('motion');
        setTimeout(function () { html.classList.remove('motion'); }, 3000);
      })();
    </script>
  </head>
  <body class="bg-paper font-sans text-ink">
    <a href="#main-content" class="portfolio-skip">本文へ移動</a>
    <slot />
  </body>
</html>
