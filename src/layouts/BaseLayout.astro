---
import '../styles/global.css';
import { getLang } from '@/lib/i18n';

import Analytics from '@/components/layout/Analytics.astro';
import SeoHead from '@/components/layout/SeoHead.astro';
interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>;
}

const { title, description, jsonLd } = Astro.props;
const lang = getLang(Astro);
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon-fumi.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- 見出しの PP Migra を先に読み込む(読み込み前の代わりのフォントは幅が広く、一瞬大きく見えるため) -->
    <link rel="preload" href="/fonts/PPMigra-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;900&display=swap"
      rel="stylesheet"
    />
    <SeoHead title={title} description={description} jsonLd={jsonLd} />
    <link rel="alternate" hreflang="ja" href={new URL('/', Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL('/en/', Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />
    <!-- 言語の振り分け:ヘッダーで選んだ言語(localStorage)→ 無ければブラウザで一番上に設定した言語。合わない方のページに来たら移す
         検索エンジンのクローラーは振り分けない(英語設定のクローラーが日本語版を読めなくなるため。両方は hreflang で伝える) -->
    <script is:inline>
      (function () {
        try {
          if (/bot|crawl|spider|slurp|facebookexternalhit|embedly|preview/i.test(navigator.userAgent)) return;
          var pref = localStorage.getItem('fumi-lang');
          var langs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language];
          var want = pref || (/^ja/i.test(langs[0] || '') ? 'ja' : 'en');
          var isEn = location.pathname.indexOf('/en') === 0;
          if (want === 'en' && !isEn) location.replace('/en/' + location.search + location.hash);
          else if (want === 'ja' && isEn) location.replace('/' + location.search + location.hash);
        } catch (e) {}
      })();
    </script>
    <!-- 登場アニメーション対象を初回描画から隠す。JS が動かなかった時は 3 秒で戻す -->
    <script is:inline>
      (function () {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var html = document.documentElement;
        html.classList.add('motion');
        setTimeout(function () { html.classList.remove('motion'); }, 3000);
      })();
    </script>
    <Analytics />
  </head>
  <body class="bg-paper font-sans text-ink">
    <a href="#main-content" class="portfolio-skip">{lang === 'en' ? 'Skip to content' : '本文へ移動'}</a>
    <slot />
  </body>
</html>
