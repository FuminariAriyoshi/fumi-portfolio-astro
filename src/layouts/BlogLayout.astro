---
/**
 * ブログ(/blog/)のページ枠。note と同じ白地・中央 620px の 1 カラム、文字はシステムフォント(--font-article)。
 * 日本語のみなので言語の振り分けはしない。
 */
import '../styles/global.css';
import Analytics from '@/components/layout/Analytics.astro';
import SeoHead from '@/components/layout/SeoHead.astro';
import BlogHeader from '@/components/blog/BlogHeader.astro';
import BlogFooter from '@/components/blog/BlogFooter.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  jsonLd?: Record<string, unknown>;
}

const props = Astro.props;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon-fumi.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- ヘッダーだけトップと同じ Inter(ロゴの位置をトップとそろえるため)。本文はシステムフォント -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;900&display=swap" rel="stylesheet" />
    <SeoHead {...props} />
    <Analytics />
  </head>
  <body class="flex min-h-dvh flex-col bg-paper font-article text-article-ink">
    <a href="#main-content" class="portfolio-skip">本文へ移動</a>
    <BlogHeader />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <BlogFooter />
  </body>
</html>
