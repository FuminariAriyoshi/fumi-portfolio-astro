---
/**
 * 検索エンジンとリンクのプレビュー(OGP / X)用の head 要素。<title> もここで出す。
 * URL は astro.config の site を元に絶対 URL にする(OGP の画像は絶対 URL でないと読まれない)。
 */
interface Props {
  title: string;
  description: string;
  /** プレビュー画像(public からのパス)。既定はトップの表紙 */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  /** 記事の公開日・更新日(ISO 形式) */
  publishedTime?: string;
  modifiedTime?: string;
  /** 構造化データ(JSON-LD) */
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  image = '/og.jpg',
  imageAlt = 'Hi! I’m Fumi — FumiStudio portfolio',
  type = 'website',
  publishedTime,
  modifiedTime,
  jsonLd,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
const locale = Astro.currentLocale === 'en' ? 'en_US' : 'ja_JP';
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta property="og:site_name" content="FumiStudio" />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:locale" content={locale} />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
