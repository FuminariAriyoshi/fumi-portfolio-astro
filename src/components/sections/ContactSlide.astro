---
import SlideFrame from '../layout/SlideFrame.astro';
import SlideHeading from '../ui/SlideHeading.astro';
import { socials } from '@/data/home';
---

<SlideFrame id="contact" label="Contact" tone="contact">
  <SlideHeading title="Contact" />
  <div class="mt-auto flex flex-col gap-[24px] pt-[32px]">
    <p class="font-serif text-greeting leading-auto md:text-title">Let’s work together.</p>
  </div>
  <!-- SNS は Back to top と同じ行・同じ大きさにそろえる(左に SNS、右に Back to top) -->
  <footer class="portfolio-footer">
    <ul class="flex gap-[24px]">
      {socials.map((social) => (
        <li>
          <a
            href={social.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Fumi on ${social.label} (opens in a new tab)`}
            class="underline underline-offset-4"
          >
            {social.label}
          </a>
        </li>
      ))}
    </ul>
    <a href="#top">Back to top ↑</a>
  </footer>
</SlideFrame>
