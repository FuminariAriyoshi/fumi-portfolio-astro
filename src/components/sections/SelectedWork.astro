---
/**
 * Selected Works の 1 作品(Figma 427-350)。
 * ReiKikkawa / StarWeaving は開閉するデッキ(StackedWorkDeck)。成果(推薦文・掲載)はデッキの外に置き、閉じていても見せる。
 * データがある作品: 作品名(白地)→ ロゴ → キーワードの帯 → (Before/After)→ 概要スライド → 章(ピタとびは PitatobiChapters)→ 推薦文。
 * データが無い作品は WorkPendingSlide。
 */
import SlideCanvas from '../layout/SlideCanvas.astro';
import KeywordBand from './KeywordBand.astro';
import ProjectIntroSlide from './ProjectIntroSlide.astro';
import WorkPendingSlide from './WorkPendingSlide.astro';
import PitatobiChapters from './pitatobi/PitatobiChapters.astro';
import PitatobiBeforeAfter from './pitatobi/PitatobiBeforeAfter.astro';
import WorkTitle from './WorkTitle.astro';
import WorkTestimonial from './WorkTestimonial.astro';
import ReikikkawaChapters from './reikikkawa/ReikikkawaChapters.astro';
import StarWeavingChapters from './starweaving/StarWeavingChapters.astro';
import StackedWorkDeck from './StackedWorkDeck.astro';
import { localizeProject, projects, projectTitles } from '@/data/projects';

import { getLang, tr } from '@/lib/i18n';

const lang = getLang(Astro);
interface Props {
  id: string;
  index: number;
}

const { id, index } = Astro.props;
const title = projectTitles[index];
const base = projects.find((p) => p.title === title);
// 表示用(英語版では作品名・紹介文などを英語に差し替える)。title は日本語のまま目印に使う
const project = base && localizeProject(base, lang);
const keywordsLabel = (name: string) => (lang === 'en' ? `Keywords: ${name}` : `${name} のキーワード`);
const stacked = id === 'reikikkawa' || id === 'starweaving';
// キーワードの帯の色と章スライドがあるのは現状ピタとびのみ
const bandColor: Record<string, string> = { ピタとび: 'to-work-pitatobi-deep' };
// 作品ごとの背景グラデーション(サイドバーと同じテーマカラー)
const tintClass: Record<string, string> = {
  pitatobi: 'work-tint-work-pitatobi',
  // ReiKikkawa はテーマカラーが淡いグレーで黒に埋もれるので、グラデーションの色を強める
  reikikkawa: 'work-tint-vivid-work-reikikkawa',
  starweaving: 'work-tint-work-starweaving',
};
---

{/* 作品と作品の間は、作品の中(14px)より広く空けてまとまりを見せる */}
{/* 作品の中の写真はクリックで拡大できる(ImageLightbox の data-lightbox-zone) */}
<div id={id} data-lightbox-zone class:list={['flex w-full shrink-0 flex-col gap-[14px]', index > 0 && 'mt-[48px]', tintClass[id]]}>
  {project && stacked && (
    <StackedWorkDeck
      project={project}
      id={id}
      coverVideoId={id === 'reikikkawa' ? '1188937366' : '1188937811'}
      revealTitle
    >
      <KeywordBand words={project.keywords} toClass="to-ink-soft" label={keywordsLabel(project.title)} />
      <SlideCanvas id={`${id}-intro`}><ProjectIntroSlide project={project} /></SlideCanvas>
      {id === 'reikikkawa' ? <ReikikkawaChapters /> : <StarWeavingChapters />}
    </StackedWorkDeck>
  )}
  {/* 成果はデッキを開かなくても見せる */}
  {project && id === 'reikikkawa' && (
    <>
      <WorkTestimonial name="吉川 伶" />
    </>
  )}
  {project && id === 'starweaving' && <StarWeavingChapters part="outcome" />}
  {!stacked && (project ? (
    <>
      {/* 作品名はロゴ画像で見せ、テキストの作品名は出さない。Client / Year / Role はロゴの下 */}
      <h2 class="sr-only">{project.title}</h2>
      <div class:list={['relative w-full overflow-clip rounded-frame', id === 'pitatobi' ? 'aspect-[1182/451]' : 'aspect-video']}>
        <img
          src={project.image.src}
          alt={project.image.alt}
          width="3840"
          height="2160"
          loading="lazy"
          class="absolute inset-0 size-full object-cover object-[50%_45%]"
        />
      </div>
      <WorkTitle project={project} showTitle={false} />
      <KeywordBand words={project.keywords} toClass={bandColor[title] ?? 'to-ink-soft'} label={keywordsLabel(project.title)} />
      {title === 'ピタとび' && <PitatobiBeforeAfter />}
      <SlideCanvas id={`${id}-intro`}>
        <ProjectIntroSlide project={project} />
      </SlideCanvas>
    </>
  ) : (
    <SlideCanvas>
      <WorkPendingSlide title={title} index={index} projectTitles={projectTitles} />
    </SlideCanvas>
  ))}


  {title === 'ピタとび' && (
    <>
      <PitatobiChapters />
      <WorkTestimonial name="中嶋 来門" />
    </>
  )}
</div>
