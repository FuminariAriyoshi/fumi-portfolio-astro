---
/** 作品の冒頭(白地): 作品名と Client / Year / Role(Figma 428-3685) */
import MetaItem from '../ui/MetaItem.astro';
import type { Project } from './ProjectSlide.astro';

interface Props {
  project: Project;
  compactTitle?: boolean;
  responsiveTitle?: boolean;
  /** 作品名の下に紹介文を出す */
  intro?: string;
  showTitle?: boolean;
  showMeta?: boolean;
  /** 作品名を PP Migra(font-serif)にする */
  serif?: boolean;
  /** 上下の余白(48px)を付けない(呼ぶ側で間を決める時) */
  flush?: boolean;
}

const { project, compactTitle = false, responsiveTitle = false, intro, showTitle = true, showMeta = true, serif = false, flush = false } = Astro.props;
---

<header class:list={['flex w-full shrink-0 flex-col gap-[16px]', !flush && 'py-[48px]']}>
  {showTitle && <h2 class:list={['leading-auto', serif ? 'font-serif font-normal' : 'font-semibold tracking-tighter', compactTitle ? 'text-subtitle' : responsiveTitle ? 'text-subtitle md:text-title' : 'whitespace-nowrap text-title']}>{project.title}</h2>}
  {intro && <p class="max-w-[720px] text-meta leading-body">{intro}</p>}
  {showMeta && <div class="flex flex-wrap items-start gap-x-[24px] gap-y-[8px] text-meta">
    {project.client && <MetaItem label="Client"><p class="leading-body">{project.client}</p></MetaItem>}
    <MetaItem label="Year"><p class="leading-body">{project.year}</p></MetaItem>
    <MetaItem label="Role"><p class="leading-body">{project.role}</p></MetaItem>
    {project.team && <MetaItem label="Team"><p class="leading-body">{project.team}</p></MetaItem>}
  </div>}
</header>
