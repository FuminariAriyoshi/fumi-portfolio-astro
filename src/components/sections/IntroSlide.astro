---
/**
 * 1 枚目: 自己紹介。背景に流れる単語 2 列と中央の「Hi! I'm Fumi」。
 * 1280×720 の固定キャンバス(SlideCanvas)に組み、列幅に合わせて丸ごと拡大縮小する(どの画面幅でも同じ構図)。
 * 座標は Figma 420-199(幅 1142)を 1280 に拡大したもの。
 */
import MemojiAvatar from '../ui/MemojiAvatar.astro';
import SlideCanvas from '../layout/SlideCanvas.astro';
import Slide from '../layout/Slide.astro';

interface Props {
  /** ほかのページで表紙を縮めて見せる時(About のホームへの誘導)。id="top" を付けず、顔も動かさない */
  preview?: boolean;
}

const { preview = false } = Astro.props;
const topWords = ['花札', '京都', '英語オタク'];
const bottomWords = ['Design', 'Tech', 'Japan', 'Claude'];
// 列は同じ単語を 2 回並べて継ぎ目なく流す(lib/marquee.ts)。止まっている時の見た目は 1 列目と同じ
const rowClass = 'absolute flex cursor-grab items-center whitespace-nowrap font-black leading-auto text-paper opacity-50 text-marquee select-none touch-pan-y data-dragging:cursor-grabbing';
---

<SlideCanvas id={preview ? undefined : 'top'}>
  <Slide label="Hi, I'm Fumi">
    <!-- 単語の列は、押したまま左右にドラッグするとその列だけ動く(lib/marquee.ts。上下は連動させない。ユーザー指定) -->
    <div class="absolute inset-0 bg-tint-slide-fumi">
      <p aria-hidden="true" data-enter="row" data-marquee-interactive data-from="right" class:list={[rowClass, 'top-[-49px] left-[-153px]']}>
        <span class="flex" data-marquee="reverse" data-duration="70">
          {[0, 1].map(() => (
            <span class="flex shrink-0 gap-[27px] pr-[27px]">{topWords.map((word) => <span>{word}</span>)}</span>
          ))}
        </span>
      </p>
      <p aria-hidden="true" data-enter="row" data-marquee-interactive data-from="left" class:list={[rowClass, 'top-[503px] left-[-167px]']}>
        <span class="flex" data-marquee="forward" data-duration="80">
          {[0, 1].map(() => (
            <span class="flex shrink-0 gap-[27px] pr-[27px]">{bottomWords.map((word) => <span>{word}</span>)}</span>
          ))}
        </span>
      </p>

      <!-- 顔と挨拶のまとまりは、左右はキャンバスの中央、上下は上下の単語の列の間(文字の見た目)の中央に置く。
           スマホではキャンバスごと小さくなるので、まとまりだけ少し大きくする -->
      <div class="absolute top-[307px] left-1/2 flex origin-center max-md:top-[299px] -translate-x-1/2 items-center gap-[25px] max-md:scale-[1.15]">
        <MemojiAvatar size={118} still={preview} />
        <h1 class="flex flex-col items-start leading-auto text-paper">
          <span data-enter="line" class="mb-[-12px] text-greeting">Hi!</span>
          <span class="flex items-center gap-[12px] whitespace-nowrap">
            <span data-enter="line" class="text-greeting">I’m</span>
            <span data-enter="line" class="font-serif text-name">Fumi</span>
          </span>
        </h1>
      </div>
    </div>
  </Slide>
</SlideCanvas>
