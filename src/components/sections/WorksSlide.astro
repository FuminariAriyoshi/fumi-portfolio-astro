---
/**
 * 02 Works。各作品の行に写真/動画のサムネ・ジャンル、右に成果と推薦の言葉(あるものだけ)。クライアント名・期間は出さない。
 * 推薦の言葉は data/about.ts の原文から一文を抜き出したもの(顔写真も about.ts)。成果には写真を添える。
 * 最後に Other Works の行(→ Other Works のスライド)。
 */
import SlideFrame from '../layout/SlideFrame.astro';
import SlideHeading from '../ui/SlideHeading.astro';
import MediaThumb from '../ui/MediaThumb.astro';
import { projects } from '@/data/projects';
import { testimonials } from '@/data/about';
import { buildMutedEmbedSrc, getAllPortfolios, imageAttrs } from '@/lib/works';

import { getLang, tr } from '@/lib/i18n';

const lang = getLang(Astro);
const $ = (ja: string, en: string) => (lang === 'en' ? en : ja);
const personOf = (name: string) => testimonials.find((t) => t.name === name);

// ケーススタディの映像(Vimeo の背景再生)。ピタとびは動画が無いので写真
const vimeo = (id: string) => `https://player.vimeo.com/video/${id}?background=1&autoplay=1&loop=1&dnt=1`;
const imageOf = (title: string) => {
  const src = projects.find((p) => p.title === title)?.image?.src;
  return src ? { src } : null;
};

const items = [
  {
    title: 'ピタとび',
    label: $('ピタとび', 'Pitatobi'),
    href: '#pitatobi',
    genre: 'Rebranding / UIUX / Development',
    // ホバーで出す、作品の色のグラデーション(クラス名は Tailwind が拾えるよう省略しない)
    tint: 'bg-tint-strong-work-pitatobi',
    result: null,
    // ブランディングの視点のコメント
    quote: { text: $('Webサイトの UI/UX はもちろん、サービス名の検討からキャラクター制作、ブランドカラーの策定まで、ピタとびのブランディング全体に幅広く携わってくれました。', 'Beyond the website’s UI/UX, you were involved in the whole Pitatobi brand, from exploring the service name to creating the character and defining the brand colors.'), name: '中嶋 来門' },
    image: imageOf('ピタとび'),
    videoSrc: null,
  },
  {
    title: 'ReiKikkawa Graduation Work',
    href: '#reikikkawa',
    genre: 'Web / UIUX / Client Work',
    tint: 'bg-tint-strong-work-reikikkawa',
    result: null,
    quote: { text: $('Webサイトが実現するなんて思っていなかったので、こんなにかっこよく作ってもらえて嬉しかったです！', 'I never imagined the website would actually come to life, so I’m thrilled you made it look this amazing!'), name: '吉川 伶' },
    image: imageOf('ReiKikkawa Graduation Work'),
    videoSrc: vimeo('1188937366'),
  },
  {
    title: 'StarWeaving',
    href: '#starweaving',
    genre: 'Interactive / Experimental',
    tint: 'bg-tint-strong-work-starweaving',
    result: { text: $('学科紹介パンフレット(2026)に掲載', 'Featured in the 2026 department brochure'), image: '/works/starweaving/recognition.png', alt: $('StarWeavingが掲載された武蔵野美術大学の2026年学科紹介パンフレット', 'Musashino Art University’s 2026 department brochure featuring StarWeaving') },
    quote: null,
    image: imageOf('StarWeaving'),
    videoSrc: vimeo('1188937811'),
  },
];

// Other Works：サムネは PrismFont & Asset(uid 6)の映像
const { ja } = await getAllPortfolios();
const otherThumb = ja.find((work) => work.uid === '6');
const otherVideo = (otherThumb?.data.video as any[] | undefined)?.find((item) => item.video?.html)?.video?.html;
items.push({
  title: 'Other Works',
  href: '/works/other',
  newTab: true,
  genre: 'Branding / Web / Graphic / Typeface / Drawing',
  // Other Works は色を付けず、白をうっすら重ねるだけ(目立たせない)
  tint: 'bg-linear-to-br from-paper/5 to-paper/25',
  result: null,
  quote: null,
  image: otherThumb ? imageAttrs(otherThumb.data.portfolio, '(max-width: 767px) 100vw, 176px') : null,
  videoSrc: otherVideo ? buildMutedEmbedSrc(otherVideo) : null,
});
---

<SlideFrame id="works" label="Works" tone="ink">
  <SlideHeading title="Works" />
  <ol class="mt-auto flex flex-col gap-[4px] pt-[24px]">
    {items.map((item) => (
      <li data-reveal-row>
        <a
          href={item.href}
          target={'newTab' in item && item.newTab ? '_blank' : undefined}
          rel={'newTab' in item && item.newTab ? 'noopener noreferrer' : undefined}
          aria-label={'newTab' in item && item.newTab ? $(`${item.title}の一覧を新しいタブで開く`, `Open ${item.title} in a new tab`) : `View case study: ${'label' in item && item.label ? item.label : item.title}`} class="group relative -mx-[12px] flex flex-col items-stretch gap-[12px] rounded-card px-[12px] py-[10px] leading-auto md:flex-row md:items-center md:gap-[24px]">
          {item.tint && <span class:list={['pointer-events-none absolute inset-0 rounded-card opacity-100 transition-opacity duration-500 md:opacity-0 md:group-hover:opacity-100 md:group-focus-visible:opacity-100', item.tint]} aria-hidden="true"></span>}
          <span class="relative w-full shrink-0 md:w-[176px]" data-reveal-part><MediaThumb image={item.image} videoSrc={item.videoSrc} /></span>
          <span class="relative grid min-w-0 flex-1 grid-cols-1 gap-x-[24px] gap-y-[6px] md:grid-cols-2 md:items-center">
            <span class="flex flex-col gap-[4px]">
              <span class="text-nav font-semibold" data-reveal-part>{'label' in item && item.label ? item.label : item.title}</span>
              <span class="text-small opacity-60" data-reveal-part>{item.genre}</span>
            </span>
            {(item.result || item.quote) && (
              <span class="flex flex-col gap-[4px]">
                {item.result && (
                  <span class="flex items-center gap-[10px]" data-reveal-part>
                    {item.result.image && <img src={item.result.image} alt={item.result.alt} loading="lazy" class="h-[40px] w-[56px] shrink-0 rounded-[4px] bg-paper object-cover" />}
                    <span class="text-small leading-[1.6] opacity-80">{item.result.text}</span>
                  </span>
                )}
                {item.quote && (() => {
                  const person = personOf(item.quote.name);
                  return (
                    <span class="flex items-start gap-[10px]" data-reveal-part>
                      {person && <img src={person.avatar} alt={$(`${person.name}さんの顔写真`, `Photo of ${person.nameEn}`)} loading="lazy" class="size-[32px] shrink-0 rounded-full object-cover" />}
                      <span class="flex min-w-0 flex-col gap-[4px]">
                        <span class="text-small leading-[1.6] opacity-80">“{item.quote.text}”</span>
                        <span class="flex flex-wrap gap-x-[8px] text-micro leading-auto opacity-50"><span>{lang === 'en' && person ? person.nameEn : item.quote.name}</span>{person && <span>{tr(lang, person.role)}</span>}</span>
                      </span>
                    </span>
                  );
                })()}
              </span>
            )}
          </span>
        </a>
      </li>
    ))}
  </ol>
</SlideFrame>
