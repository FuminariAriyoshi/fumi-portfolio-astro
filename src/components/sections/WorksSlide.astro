---
import SlideFrame from '../layout/SlideFrame.astro';
import SlideHeading from '../ui/SlideHeading.astro';
import { projects, projectTitles } from '@/data/projects';

// 個別ページがある作品だけリンクにする
const items = projectTitles.map((title) => {
  const project = projects.find((p) => p.title === title);
  return { title, href: ['#pitatobi', '#reikikkawa', '#starweaving'][projectTitles.indexOf(title)], meta: project ? [project.client ?? project.team, project.year].filter(Boolean).join(' — ') : 'Case study in preparation' };
});
---

<SlideFrame id="works" label="Works" tone="ink">
  <SlideHeading title="Works" />
  <ol class="mt-auto flex flex-col pt-[32px]">
    {items.map((item) => {
      const Tag = item.href ? 'a' : 'div';
      return (
        <li class="border-t border-paper/30 last:border-b">
          <Tag
            href={item.href}
            aria-label={item.href ? `View case study: ${item.title}` : undefined}
            class="flex flex-col gap-[4px] py-[16px] leading-auto md:flex-row md:items-baseline md:justify-between"
          >
            <span class="text-nav font-semibold">{item.title}</span>
            <span class="text-meta opacity-60">{item.meta}</span>
          </Tag>
        </li>
      );
    })}
  </ol>
</SlideFrame>
