---
/**
 * 作品の成果の数字を、大きな打ち抜き文字で並べる帯(枠なし)。流さずに固定で見せる。
 * 上に細い線。注記は母数(basis)と期間(period)。
 * 1行に1つ。左に見出し(上)と注記(下)、右に大きな数字(text-stat)。帯の幅が 48rem 未満なら縦に積んで数字を小さく。
 * from がある数字は「from → value」で、変化前を薄く、矢印は SVG(フォントの → は字面の高さが揃わないため)。
 */
import { slideType as t } from '@/lib/slideType';

import { getLang, tr } from '@/lib/i18n';

const lang = getLang(Astro);
interface Stat {
  label: string;
  value: string;
  /** 変化前の値(例: LINE登録者数 0 → 87) */
  from?: string;
  unit?: string;
  /** 母数・内訳(例: 診断を開始した11人のうち10人が完了) */
  basis?: string;
  /** 計測期間 */
  period: string;
}

interface Props {
  stats: Stat[];
  /** グラデーションの終わりの色(Tailwind の to-* クラス) */
  toClass: string;
  label: string;
}

const { stats, toClass, label } = Astro.props;
const textClass = ['bg-linear-to-b from-ink from-[10%] to-80% bg-clip-text text-transparent', toClass];
---

<section aria-label={label} class="@container w-full shrink-0 px-[24px] md:px-[40px]">
  <dl class="flex flex-col">
    {stats.map((stat) => (
      <div class="grid grid-cols-1 gap-y-[12px] border-t border-ink/15 py-[24px] @3xl:grid-cols-[1fr_auto] @3xl:grid-rows-[auto_1fr] @3xl:gap-x-[40px]">
        <dt class="text-meta leading-auto @3xl:col-start-1 @3xl:row-start-1">{stat.label}</dt>
        <dd class="flex items-baseline whitespace-nowrap font-black leading-none text-greeting md:text-title @3xl:col-start-2 @3xl:row-span-2 @3xl:row-start-1 @3xl:self-center @3xl:text-stat">
          {stat.from && (
            <>
              <span class="sr-only">{lang === 'en' ? `from ${stat.from}${!stat.unit || stat.unit === '%' ? stat.unit ?? '' : ` ${stat.unit}`} to ` : `${stat.from}${stat.unit}から`}</span>
              <span aria-hidden="true" class="flex items-center gap-[12px] self-center pr-[12px] opacity-25 @3xl:gap-[24px] @3xl:pr-[24px]">
                <span>{stat.from}</span>
                <svg viewBox="0 0 48 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="h-auto w-[32px] md:w-[48px] @3xl:w-[88px]">
                  <path d="M2 12h42M34 3l10 9-10 9" />
                </svg>
              </span>
            </>
          )}
          <span class:list={textClass}>{stat.value}</span>
          {stat.unit && <span class="pl-[6px] text-nav font-bold md:text-subtitle @3xl:pl-[12px] @3xl:text-greeting-lg">{stat.unit}</span>}
        </dd>
        <dd class="flex flex-col @3xl:col-start-1 @3xl:row-start-2 @3xl:self-end">
          {stat.basis && <span class="text-small leading-body">{stat.basis}</span>}
          <span class={t.note}>{stat.period}</span>
        </dd>
      </div>
    ))}
  </dl>
</section>
