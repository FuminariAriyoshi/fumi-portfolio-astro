---
/**
 * 推薦文(Figma 427-350): 見出しは白地に出し、その下の角丸の箱の中でカードを横に流す
 * (lib/marquee.ts の等速ループ。スクロールには連動しない)。押したまま左右にドラッグして動かせる。
 * ループの継ぎ目が出ないよう同じ列を 2 回並べ、2 つ目は読み上げから外す。
 */
import SlideHeading from '../ui/SlideHeading.astro';
import TestimonialCard from '../ui/TestimonialCard.astro';
import { testimonialColumns } from '@/data/about';
---

<section id="about-testimonials" aria-label="Testimonials" class="flex w-full shrink-0 flex-col gap-[14px] py-[34px]">
  <div class="px-[24px] md:px-[40px]">
    <SlideHeading title="Testimonials" />
  </div>
  <div class="overflow-clip rounded-slide bg-ink bg-tint-slide-about py-[40px] text-paper">
    <div
      data-marquee-interactive
      class="cursor-grab touch-pan-y select-none data-dragging:cursor-grabbing motion-reduce:cursor-auto motion-reduce:overflow-x-auto motion-reduce:select-auto"
    >
      <div class="flex w-max items-stretch" data-marquee="forward" data-duration="80">
        {[0, 1].map((copy) => (
          <div class="flex shrink-0 items-stretch gap-[12px] pr-[12px]" aria-hidden={copy === 1 ? 'true' : undefined}>
            {testimonialColumns.map((column) => (
              <div class="flex shrink-0 flex-col gap-[12px]">
                {column.map((item) => <TestimonialCard item={item} class="flex-1" />)}
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
