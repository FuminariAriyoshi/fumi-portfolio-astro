---
import SlideFrame from '../layout/SlideFrame.astro';
import SlideHeading from '../ui/SlideHeading.astro';
import { awards, intro } from '@/data/home';
---

<SlideFrame id="about" label="About" tone="accent">
  <SlideHeading number="01" title="About" />
  <div class="mt-auto flex flex-col gap-[32px] pt-[32px] md:flex-row md:items-end md:justify-between">
    <div class="flex max-w-[520px] flex-col gap-[4px] text-meta leading-body">
      {intro.map((line) => <p>{line}</p>)}
    </div>
    <dl class="flex shrink-0 flex-col gap-[12px]">
      {awards.map((award) => (
        <div class="flex flex-col leading-auto">
          <dt class="font-serif text-nav">{award.name}</dt>
          <dd class="text-meta opacity-80">{award.prize}</dd>
        </div>
      ))}
    </dl>
  </div>
</SlideFrame>
