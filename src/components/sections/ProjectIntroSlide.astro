---
/**
 * 作品の概要スライド(Figma 428-2313)。1280×720 の資料型スライドで(中身は縦中央)、Introduction だけを載せる。
 * (作品名と Client / Year / Role は WorkTitle、ロゴは SelectedWork の上部、キーワードは KeywordBand に分けた)
 * 見出しと本文は ScrollReveal で行ごとに切り抜き、1文字ずつ下から出す(data-reveal-scope / data-reveal-chars)。
 * スマホ(md 未満)では章スライドと同じくキャンバスを縮めずに出す(data-chapter。global.css)。本文 20px・ラベル 16px
 */
import Slide from '../layout/Slide.astro';
import type { Project } from './ProjectSlide.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<Slide label={project.title}>
  <div class="flex flex-col justify-center gap-[51px] px-[20px] py-[32px] md:absolute md:inset-y-0 md:left-[38px] md:w-[1218px] md:p-0" data-chapter data-reveal-scope data-reveal-chars>
    <div class="flex flex-col gap-[14px]">
      <p class="font-serif text-meta leading-auto md:text-body">Introduction</p>
      <p class="text-body leading-body tracking-[-0.03em] md:text-subtitle md:tracking-[-0.05em]">{project.intro}</p>
    </div>
  </div>
</Slide>
