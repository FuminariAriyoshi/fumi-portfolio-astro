---
/** Education の 1 行: 期間 / 名称と補足(縦に積む) */
import type { CareerItem } from '@/data/about';

interface Props {
  item: CareerItem;
}

const { item } = Astro.props;
---

<li class="grid grid-cols-[104px_1fr] items-start gap-x-[16px] leading-auto">
  <span class="text-kicker opacity-60">{item.period}</span>
  <span class="flex flex-col gap-[8px]">
    <span class="text-meta">{item.title}</span>
    <span class="text-kicker opacity-60">{item.role}</span>
  </span>
</li>
