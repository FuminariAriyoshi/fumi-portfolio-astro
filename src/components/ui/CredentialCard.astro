---
/**
 * 資格・受賞 1 件: 上に画像、下に日付・名前・補足を中央そろえ。
 * カード全体がボタンになり、ImageLightbox で画像を大きく表示する(別ページには飛ばない)。
 * 親の ul と subgrid で「画像の段」「文字の段」をそろえ、画像は下端・文字は上端で並べる(文字の行数が違っても画像の下端がそろう)。
 * 画像枠の比率は boxAspect(Figma 427-350 の枠の比率)。横長のスコアは枠いっぱいに切り抜き、縦長の証明書は枠に収める
 */
import type { Credential } from '@/data/about';

interface Props {
  item: Credential;
  /** 画像枠の比率(例: '145/128') */
  boxAspect: string;
  fit?: 'cover' | 'contain';
}

const { item, boxAspect, fit = 'contain' } = Astro.props;
const image = item.image;
const caption = [item.name, item.detail].filter(Boolean).join(' ');
---

<li class="row-span-2 grid min-w-0 grid-rows-subgrid">
  <button
    type="button"
    data-lightbox-src={image?.src}
    data-lightbox-alt={image?.alt}
    data-lightbox-width={image?.width}
    data-lightbox-height={image?.height}
    data-lightbox-caption={`${caption}(${item.date})`}
    aria-label={`${caption} の画像を拡大表示`}
    aria-haspopup="dialog"
    class="row-span-2 grid w-full cursor-zoom-in grid-rows-subgrid justify-items-center"
  >
    {image && (
      <span class="flex w-full items-center justify-center self-end overflow-clip rounded-media bg-paper/10" style={`aspect-ratio: ${boxAspect}`}>
        <img
          src={image.src}
          alt=""
          width={image.width}
          height={image.height}
          loading="lazy"
          class:list={['size-full', fit === 'cover' ? 'object-cover' : 'object-contain']}
        />
      </span>
    )}
    <span class="row-start-2 flex flex-col items-center gap-[2px] self-start text-center leading-auto" data-reveal="body">
      <span class="text-kicker opacity-50">{item.date}</span>
      <span class="font-serif text-meta">{item.name}</span>
      {item.detail && <span class="text-kicker opacity-70">{item.detail}</span>}
    </span>
  </button>
</li>
