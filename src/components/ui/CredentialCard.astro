---
/**
 * 資格・受賞 1 件: 上に画像、下に日付・名前・補足を中央そろえ。
 * カード全体がボタンになり、ImageLightbox で画像を大きく表示する(別ページには飛ばない)。
 * 画像枠の比率は boxAspect(Figma 427-350 の枠の比率)。横長のスコアは枠いっぱいに切り抜き、縦長の証明書は枠に収める
 */
import type { Credential } from '@/data/about';

interface Props {
  item: Credential;
  /** 画像枠の比率(例: '145/128') */
  boxAspect: string;
  fit?: 'cover' | 'contain';
}

const { item, boxAspect, fit = 'contain' } = Astro.props;
const image = item.image;
const caption = [item.name, item.detail].filter(Boolean).join(' ');
---

<li class="min-w-0">
  <button
    type="button"
    data-lightbox-src={image?.src}
    data-lightbox-alt={image?.alt}
    data-lightbox-width={image?.width}
    data-lightbox-height={image?.height}
    data-lightbox-caption={`${caption}(${item.date})`}
    aria-label={`${caption} の画像を拡大表示`}
    aria-haspopup="dialog"
    class="flex w-full cursor-zoom-in flex-col items-center gap-[8px]"
  >
    {image && (
      <span class="flex w-full items-center justify-center overflow-clip rounded-media bg-paper/10" style={`aspect-ratio: ${boxAspect}`}>
        <img
          src={image.src}
          alt=""
          width={image.width}
          height={image.height}
          loading="lazy"
          class:list={['size-full', fit === 'cover' ? 'object-cover' : 'object-contain']}
        />
      </span>
    )}
    <span class="flex flex-col items-center gap-[2px] text-center leading-auto">
      <span class="text-kicker opacity-50">{item.date}</span>
      <span class="font-serif text-meta">{item.name}</span>
      <!-- 補足が無いものも同じ高さにして、画像の下端をそろえる -->
      <span class="text-kicker opacity-70">{item.detail || '\u00a0'}</span>
    </span>
  </button>
</li>
