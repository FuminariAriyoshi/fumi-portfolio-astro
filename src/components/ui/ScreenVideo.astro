---
interface Props {
  src: string;
  poster?: string;
  label: string;
  class?: string;
}
const { src, poster, label, class: className } = Astro.props;
---

<video src={src} poster={poster} aria-label={label} autoplay muted loop playsinline preload="metadata" class:list={['object-cover object-top', className]}></video>
