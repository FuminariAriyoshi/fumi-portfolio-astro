---
/** 画像の一部だけを見せる枠(studio-fumi の CroppedImage)。crop は Figma の値(%)をそのまま渡す */
interface Props {
  src: string;
  alt: string;
  aspect: string;
  crop: { width: string; height: string; left: string; top: string };
  class?: string;
}

const { src, alt, aspect, crop, class: className } = Astro.props;
---

<div class:list={['relative overflow-clip', className]} style={`aspect-ratio: ${aspect}`}>
  <img
    src={src}
    alt={alt}
    loading="lazy"
    class="absolute max-w-none select-none"
    style={`width:${crop.width};height:${crop.height};left:${crop.left};top:${crop.top}`}
  />
</div>
