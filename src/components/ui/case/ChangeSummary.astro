---
/**
 * BEFORE の課題と AFTER の成果を、同じ3列・同じ位置に並べる(studio-fumi の ChangeSummary)。
 * 切り替えた時に同じ場所で ❌ → ✅ に入れ替わるので、変化が一目でわかる。
 */
export interface Change {
  before: string;
  after: string;
}

interface Props {
  phase: 'before' | 'after';
  eyebrow: string;
  changes: Change[];
}

const { phase, eyebrow, changes } = Astro.props;
---

<div class="flex w-full flex-col items-center gap-[16px]">
  <p class="text-small tracking-[0.04em] opacity-60">{eyebrow}</p>
  <ul class="grid w-full grid-cols-1 gap-y-[20px] sm:grid-cols-3 sm:gap-x-[24px]">
    {changes.map((change) => (
      <li class="flex flex-col items-center gap-[4px] text-center">
        <span class="text-balance text-nav font-medium leading-[1.4]">
          {phase === 'before' ? '❌' : '✅'}{phase === 'before' ? change.before : change.after}
        </span>
        {phase === 'after' && (
          <span class="text-kicker line-through opacity-40"><span class="sr-only">改善前：</span>{change.before}</span>
        )}
      </li>
    ))}
  </ul>
</div>
