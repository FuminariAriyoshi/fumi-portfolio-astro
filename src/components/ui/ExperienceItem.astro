---
/** Experience の 1 件: 名称 / 役割 / 期間(右寄せ)と、何をしていたか */
import type { CareerItem } from '@/data/about';

import { getLang, tr } from '@/lib/i18n';

const lang = getLang(Astro);
interface Props {
  item: CareerItem;
}

const { item } = Astro.props;

---

<li class="flex flex-col gap-[6px] leading-auto" data-reveal-row>
  <div class="flex flex-wrap items-baseline gap-x-[8px] gap-y-[2px]" data-reveal-part>
    <span class="text-meta">{tr(lang, item.title)}</span>
    <span class="text-kicker opacity-60">{tr(lang, item.role)}</span>
    <span class="ml-auto text-kicker opacity-50">{tr(lang, item.period)}</span>
  </div>
  {item.description && <p class="text-kicker leading-[1.5] opacity-50" data-reveal-part>{tr(lang, item.description)}</p>}
</li>
