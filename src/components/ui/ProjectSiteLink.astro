---
interface Props { href: string; title: string; text?: string; class?: string; }
const { href, title, text = 'Visit Site', class: className } = Astro.props;
---
<a href={href} target="_blank" rel="noopener noreferrer" aria-label={`${title}を見る（新しいタブ）`} class:list={['self-start text-meta underline underline-offset-4', className]}>{text} ↗</a>
