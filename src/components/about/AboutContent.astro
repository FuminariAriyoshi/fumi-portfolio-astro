---
/**
 * /about の中身(旧サイト FumiPortfolio の About と同じ構成)。1 言語ぶん。
 * 上：顔と名前・推薦文の帯 / 下：3 列(Philosophy・Introduction・Education / Experience / Language・Certifications・Awards)
 * 最後にホームへの誘導。
 */
import MemojiAvatar from '../ui/MemojiAvatar.astro';
import AboutBlock from './AboutBlock.astro';
import AboutRow from './AboutRow.astro';
import DocButton from './DocButton.astro';
import TestimonialsTicker from './TestimonialsTicker.astro';
import HomeCta from './HomeCta.astro';
import { aboutPage as a, type Lang } from '@/data/aboutPage';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ja = lang === 'ja';
const textClass = ['text-xs leading-tight', ja ? 'font-medium' : 'font-normal'];
---

<div class="flex w-full flex-col gap-[clamp(1rem,4vh,3rem)]">
  <!-- 顔・名前と推薦文の帯 -->
  <div class="flex w-full flex-col justify-between gap-6 md:flex-row md:items-center md:gap-12">
    <div class="flex shrink-0 items-center gap-6 md:gap-8" data-about-in>
      <MemojiAvatar size={72} />
      <div class="flex flex-col gap-1">
        <h1 class="font-serif text-[clamp(1.25rem,3.5vh,2.25rem)] font-medium tracking-[-0.04em]">{a.name}</h1>
        {ja && <p class="mt-1 text-sm tracking-wide text-white/50 md:text-base">{a.nameJa}</p>}
      </div>
    </div>
    <div class="min-w-0 flex-1" data-about-in>
      <TestimonialsTicker lang={lang} />
    </div>
  </div>

  <!-- 3 列とホームへの誘導の間は 36px(gap-9) -->
  <div class="flex w-full flex-col gap-9">
  <div class="grid w-full grid-cols-1 gap-[clamp(1rem,4vh,3rem)] md:grid-cols-3">
    <!-- 1 列目 -->
    <div class="flex min-h-0 flex-col gap-8">
      <AboutBlock label="PHILOSOPHY" number="00">
        <!-- 信条の一文は本文と分けて大きく出す -->
        <p class="mb-1 font-serif text-2xl leading-tight tracking-[-0.03em]">{a.tagline}</p>
        <p class:list={textClass}>{a.philosophy[lang]}</p>
      </AboutBlock>
      <AboutBlock label="INTRODUCTION" number="01">
        <p class:list={textClass}>{a.introduction[lang]}</p>
        <div class="mt-2 flex gap-4">
          {a.socials.map((s) => (
            <a href={s.href} target="_blank" rel="noopener noreferrer" class="text-micro font-normal tracking-[-0.04rem] uppercase transition-opacity hover:opacity-50" aria-label={`${s.label}(新しいタブで開く)`}>{s.label}</a>
          ))}
        </div>
      </AboutBlock>
      <AboutBlock label="EDUCATION" number="02">
        <div class="flex flex-col gap-6">
          {a.education.map((e) => <AboutRow period={e.period[lang]} title={e.title[lang]} sub={e.sub[lang]} ja={ja} />)}
        </div>
      </AboutBlock>
    </div>

    <!-- 2 列目:経歴(枠の中でスクロール) -->
    <div class="flex h-[480px] min-h-0 flex-col gap-8 md:[@media(max-height:780px)]:h-[360px]">
      <AboutBlock label="EXPERIENCE" number="03" class="min-h-0 flex-1">
        <div class="relative -mr-2 min-h-0 flex-1 pr-2">
          <div data-lenis-prevent tabindex="0" aria-label="Experience" class="about-scroll flex h-full flex-col gap-6 overflow-y-auto overscroll-contain pr-2 pb-12 outline-none">
            {a.experience.map((e) => <AboutRow period={e.period[lang]} title={e.title[lang]} sub={e.role[lang]} desc={e.desc[lang]} ja={ja} />)}
          </div>
          <div class="pointer-events-none absolute right-2 bottom-0 left-0 h-16 bg-linear-to-t from-ink to-transparent" aria-hidden="true"></div>
        </div>
      </AboutBlock>
    </div>

    <!-- 3 列目 -->
    <div class="flex min-h-0 flex-col gap-8">
      <AboutBlock label="Language" number="04">
        <div class="flex flex-col gap-2">
          {a.languages.map((l) => (
            <div class="flex w-full items-baseline justify-between gap-2">
              <span class="text-micro font-normal whitespace-nowrap text-white/40">{l.label[lang]}</span>
              <span class:list={['inline-block w-fit text-right text-white', ...textClass]}>{l.value[lang]}</span>
            </div>
          ))}
        </div>
      </AboutBlock>
      <AboutBlock label="Certifications" number="05">
        <div class="flex flex-col gap-2">
          {a.certifications.map((c) => <DocButton date={c.date} name={c.name} doc={c.doc} ja={ja} />)}
        </div>
      </AboutBlock>
      <AboutBlock label="AWARDS" number="06">
        <div class="flex flex-col gap-2">
          {a.awards.map((c) => <DocButton date={c.date} name={c.name} doc={c.doc} award />)}
        </div>
      </AboutBlock>
      <!-- 旧サイトの Interests 枠(中身は見せず、高さだけ残す) -->
      <AboutBlock label="Interests" number="07" invisible class="max-md:hidden">
        <ul aria-hidden="true" class="invisible grid grid-cols-2 gap-x-4 gap-y-1">
          {(ja ? ['UI/UXデザイン', '3D', 'Web開発', 'ブランディング', 'AI', 'Design Thinking', 'UX5Layers'] : ['UI/UX DESIGN', '3D', 'WEB DEV', 'BRANDING', 'AI', 'DESIGN THINKING', 'UX5LAYERS']).map((cap) => (
            <li class="text-micro whitespace-nowrap text-white/60">{cap}</li>
          ))}
        </ul>
      </AboutBlock>
    </div>
  </div>

  <HomeCta />
  </div>
</div>
