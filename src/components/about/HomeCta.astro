---
/**
 * About の最後に置く、ホームへの誘導。ホームの 1 ページ目(表紙 IntroSlide)をそのまま縮めて見せる。
 * 表紙は飾りとして止めた状態で見せるだけ(動かさない。読み上げ・フォーカスの対象外)。カード全体が 1 つのリンク。
 */
import IntroSlide from '../sections/IntroSlide.astro';
---

<a href="/" class="group relative block overflow-clip rounded-xl border border-white/10" aria-label="Go to Home">
  <div class="pointer-events-none" aria-hidden="true" inert>
    <IntroSlide preview />
  </div>
  <span class="absolute inset-x-0 bottom-0 flex items-end justify-between bg-linear-to-t from-black/70 to-transparent px-6 pt-16 pb-5 transition-opacity duration-500 group-hover:opacity-80">
    <span class="font-serif text-subtitle leading-auto md:text-greeting">Go to Home</span>
    <span class="text-nav" aria-hidden="true">→</span>
  </span>
</a>
