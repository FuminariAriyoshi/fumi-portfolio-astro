---
/** About の最後に置く、ホーム(トップ)への誘導。トップの最初の写真を大きく見せる */
import { profile } from '@/data/about';

interface Props {
  label: string;
}

const { label } = Astro.props;
---

<a href="/" class="group relative mt-[clamp(2rem,6vh,4rem)] block overflow-clip rounded-xl border border-white/10" aria-label={`${label}(ポートフォリオのホームへ)`} data-about-in>
  <img src={profile.photo.src} alt="" width={profile.photo.width} height={profile.photo.height} loading="lazy" class="aspect-[16/7] w-full object-cover transition-opacity duration-500 group-hover:opacity-80" />
  <span class="absolute inset-x-0 bottom-0 flex items-end justify-between bg-linear-to-t from-black/70 to-transparent px-6 pt-16 pb-5">
    <span class="font-serif text-subtitle leading-auto md:text-greeting">{label}</span>
    <span class="text-nav" aria-hidden="true">→</span>
  </span>
</a>
