---
/**
 * トップページの中身(日本語 / と英語 /en/ で共通)。文言は各部品が Astro.currentLocale で切り替える
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import Workspace from '@/components/layout/Workspace.astro';
import IntroSlide from '@/components/sections/IntroSlide.astro';
import StatementSlide from '@/components/sections/StatementSlide.astro';
import AboutProfileSlide from '@/components/sections/AboutProfileSlide.astro';
import AboutExperienceSlide from '@/components/sections/AboutExperienceSlide.astro';
import TestimonialsSlide from '@/components/sections/TestimonialsSlide.astro';
import WorksSlide from '@/components/sections/WorksSlide.astro';
import OtherWorksSlide from '@/components/sections/OtherWorksSlide.astro';
import ContactSlide from '@/components/sections/ContactSlide.astro';
import SelectedWork from '@/components/sections/SelectedWork.astro';
import PortfolioMotion from '@/components/animations/PortfolioMotion.astro';
import ScrollReveal from '@/components/animations/ScrollReveal.astro';
import PortfolioNoteSlide from '@/components/sections/PortfolioNoteSlide.astro';
import { slides, socials } from '@/data/home';
import { getLang } from '@/lib/i18n';

const lang = getLang(Astro);
const seo = lang === 'en'
  ? {
      title: 'Fumi',
      description: 'Portfolio of Fumi (Fuminari Ariyoshi), a UI/UX and brand designer. Think logically, build intuitively. Case studies from rebranding to web design and development.',
    }
  : {
      title: 'Fumi',
      description: '有吉史成(Fumi)のポートフォリオ。UI/UX・ブランドデザイナー。Think logically, build intuitively. リブランディングから Web のデザイン・実装までのケーススタディを掲載しています。',
    };
// タブのタイトルは「Fumi」のまま。本名(有吉史成)で検索した時に出るよう、人物の構造化データで名前を伝える
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: '有吉史成',
  alternateName: ['有吉 史成', 'Fuminari Ariyoshi', 'Fumi'],
  jobTitle: 'Designer',
  url: new URL('/', Astro.site).href,
  sameAs: socials.map((social) => social.href),
};
---

<BaseLayout title={seo.title} description={seo.description} jsonLd={person}>
  <SiteHeader />
  <Workspace slides={slides}>
    <IntroSlide />
    <AboutProfileSlide />
    <StatementSlide words={['Think', 'Logically']} />
    <AboutExperienceSlide />
    <TestimonialsSlide />
    <WorksSlide />
    <SelectedWork id="pitatobi" index={0} />
    <SelectedWork id="reikikkawa" index={1} />
    <SelectedWork id="starweaving" index={2} />
    <OtherWorksSlide />
    <!-- サイドバーには出さない(ブログ記事への入口) -->
    <PortfolioNoteSlide />
    <ContactSlide />
  </Workspace>
  <PortfolioMotion />
  <ScrollReveal />
</BaseLayout>
