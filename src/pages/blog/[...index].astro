---
/** ブログ一覧(/blog/)。note のクリエイターページと同じ組み(カバーの帯 → 左にプロフィール / 右に記事カード 3 列) */
import BlogLayout from '@/layouts/BlogLayout.astro';
import BlogProfile from '@/components/blog/BlogProfile.astro';
import ArticleCard from '@/components/blog/ArticleCard.astro';
import { getPosts, postPath } from '@/lib/blog';

// 公開できる記事が無い間(本番では下書きしか無い時)は一覧ページも作らない
export async function getStaticPaths() {
  return (await getPosts()).length ? [{ params: { index: undefined } }] : [];
}

const posts = await getPosts();
---

<BlogLayout title="Blog | Fumi" description="デザイナー Fumi(有吉史成)のブログ。デザイナー就活やポートフォリオ、デザインの考え方を書いています。">
  <!-- カバーの帯はトップの表紙と同じ色(黒 + 水色のグラデーション) -->
  <div class="h-[120px] bg-ink bg-tint-slide-fumi md:h-[240px]" aria-hidden="true"></div>
  <div class="mx-auto flex max-w-[1440px] flex-col gap-[40px] px-[20px] pt-[32px] pb-[80px] md:flex-row md:gap-[32px] md:px-[35px]">
    <div class="md:w-[384px] md:shrink-0">
      <BlogProfile />
    </div>
    <section class="min-w-0 flex-1" aria-labelledby="blog-posts-heading">
      <h2 id="blog-posts-heading" class="inline-flex h-[36px] items-center rounded-full bg-article-ink/65 px-[20px] text-kicker font-bold text-paper">新着</h2>
      <ul class="mt-[24px] grid grid-cols-1 gap-x-[24px] gap-y-[32px] sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <ArticleCard
            href={postPath(post.id)}
            title={post.data.title}
            date={post.data.date}
            cover={post.data.cover}
            coverAlt={post.data.coverAlt}
          />
        ))}
      </ul>
    </section>
  </div>
</BlogLayout>
